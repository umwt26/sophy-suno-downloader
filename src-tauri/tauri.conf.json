{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sophy Studio",
  "version": "1.1.0",
  "identifier": "com.sophystudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sophy Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 850,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "hooks.nsh",
        "languages": [
          "Turkish",
          "English"
        ]
      }
    }
  }
}
